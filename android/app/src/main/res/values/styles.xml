<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material, dark: brand red #C8102E / green #00B140 on the MaterialKolor surfaces,
         with BUIK - Basic UI Kit type, spacing and 4dp shapes (see Theme.java).
         Fonts: sans-serif / sans-serif-black here (Android 7); values-v26 swaps in the
         bundled Archivo / Archivo Black (res/font). -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorPrimary">#FF241E1F</item>
        <item name="android:colorPrimaryDark">#FF120D0E</item>
        <item name="android:colorAccent">#FFFF5C70</item>
        <item name="android:colorBackground">#FF120D0E</item>
        <item name="android:textColorPrimary">#FFEEDFE1</item>
        <item name="android:textColorSecondary">#FFB5A8AA</item>
        <item name="android:colorControlNormal">#FFA79B9D</item>
        <item name="android:colorControlActivated">#FFFF5C70</item>
        <item name="android:colorControlHighlight">#33FF5C70</item>
        <!-- No app-wide buttonStyle/textAppearance: the toolbar and keyboard size their own
             views; Theme.java styles the panels' widgets, AppDialog the system dialogs. -->
        <item name="android:dropDownListViewStyle">@style/Widget.Buik.DropDownList</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
    </style>

    <style name="AppDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#FFFF5C70</item>
        <item name="android:colorControlActivated">#FFFF5C70</item>
        <item name="android:colorControlNormal">#FFA79B9D</item>
        <item name="android:colorControlHighlight">#33FF5C70</item>
        <item name="android:colorBackground">#FF241E1F</item>
        <item name="android:textColorPrimary">#FFEEDFE1</item>
        <item name="android:textColorSecondary">#FFB5A8AA</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:windowTitleStyle">@style/Widget.Buik.DialogTitle</item>
        <item name="android:textAppearanceMedium">@style/TextAppearance.Buik.P3</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.Buik.Button.Text</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/Widget.Buik.Button.Text</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/Widget.Buik.Button.Text</item>
    </style>

    <!-- The same dialog in the light theme: white card, brand red accents. -->
    <style name="AppDialogLight" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#FFC8102E</item>
        <item name="android:colorControlActivated">#FFC8102E</item>
        <item name="android:colorControlNormal">#FF5F5557</item>
        <item name="android:colorControlHighlight">#33C8102E</item>
        <item name="android:colorBackground">#FFFFFFFF</item>
        <item name="android:textColorPrimary">#FF1C1C1C</item>
        <item name="android:textColorSecondary">#FF5F5557</item>
        <item name="android:windowBackground">@drawable/dialog_bg_light</item>
        <item name="android:windowTitleStyle">@style/Widget.Buik.DialogTitle</item>
        <item name="android:textAppearanceMedium">@style/TextAppearance.Buik.P3</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.Buik.Button.Text</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/Widget.Buik.Button.Text</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/Widget.Buik.Button.Text</item>
    </style>

    <!-- BUIK type scale.  Headings: Archivo Black, line height 1.3.
         Paragraphs: Archivo, line height 1.6. -->
    <style name="TextAppearance.Buik" parent="android:TextAppearance.Material">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="TextAppearance.Buik.Heading">
        <item name="android:fontFamily">sans-serif-black</item>
    </style>
    <style name="TextAppearance.Buik.H1" parent="TextAppearance.Buik.Heading"><item name="android:textSize">40sp</item></style>
    <style name="TextAppearance.Buik.H2" parent="TextAppearance.Buik.Heading"><item name="android:textSize">32sp</item></style>
    <style name="TextAppearance.Buik.H3" parent="TextAppearance.Buik.Heading"><item name="android:textSize">28sp</item></style>
    <style name="TextAppearance.Buik.H4" parent="TextAppearance.Buik.Heading"><item name="android:textSize">24sp</item></style>
    <style name="TextAppearance.Buik.H5" parent="TextAppearance.Buik.Heading"><item name="android:textSize">20sp</item></style>
    <style name="TextAppearance.Buik.H6" parent="TextAppearance.Buik.Heading"><item name="android:textSize">16sp</item></style>
    <style name="TextAppearance.Buik.P1"><item name="android:textSize">20sp</item></style>
    <style name="TextAppearance.Buik.P2"><item name="android:textSize">18sp</item></style>
    <style name="TextAppearance.Buik.P3"><item name="android:textSize">16sp</item></style>
    <style name="TextAppearance.Buik.P4"><item name="android:textSize">14sp</item></style>
    <style name="TextAppearance.Buik.P5">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>
    <style name="Widget.Buik.DialogTitle" parent="">
        <item name="android:maxLines">1</item>
        <item name="android:scrollHorizontally">true</item>
        <item name="android:textAppearance">@style/TextAppearance.Buik.H5</item>
    </style>

    <!-- BUIK buttons: 48dp tall, 16dp side insets, label in the heavy face, not all caps. -->
    <style name="Widget.Buik.Button.Text" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?android:attr/colorAccent</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <!-- The open drop-down list: no dividers (each row is 48dp, see Theme.dropdownRow). -->
    <style name="Widget.Buik.DropDownList" parent="android:Widget.Material.ListView.DropDown">
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">0dp</item>
    </style>
</resources>
