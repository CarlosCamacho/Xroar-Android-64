diff --git a/src/emesdos09.c b/src/emesdos09.c
new file mode 100644
index 00000000..624dc915
--- /dev/null
+++ b/src/emesdos09.c
@@ -0,0 +1,272 @@
+/* emesDOS09 smart cartridge: a 16K ROM in two banks plus an SD controller.
+ *
+ * Copyright 2026
+ *
+ * This file is part of XRoar, a Dragon/Tandy CoCo emulator.
+ *
+ * XRoar is free software; you can redistribute it and/or modify it under the
+ * terms of the GNU General Public License as published by the Free Software
+ * Foundation, either version 3 of the License, or (at your option) any later
+ * version.
+ *
+ * See COPYING.GPL for redistribution conditions.
+ */
+
+/* The cartridge of Carlos Camacho's emesDOS09 (github.com/CarlosCamacho/
+ * EmEsDOS09), as its EMULATOR-CONTRACT.md describes it:
+ *
+ *   $C000-$DFFF  the selected 8K bank of the 16K ROM (bank 0 then bank 1)
+ *   $FF40        bit 7 selects the bank; bits 0-6, if not zero, run a command
+ *   $FF41-$FF4F  status, FIFO, error, arguments, count, capabilities, ack
+ *
+ * The controller behind the registers is the project's own PIC32 firmware
+ * command code (emesdos09/emes_fw.c), with the SD card being the file given
+ * as hard disk 0 (-load-hd0): a raw FAT16 image, superfloppy or partitioned,
+ * in 512-byte sectors.
+ *
+ * The real board leaves $E000-$FEFF to its CPLD; here the selected bank is
+ * mirrored there, as a 16K ROM with A13 driven by the bank bit would be. */
+
+#include "top-config.h"
+
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#include "sds.h"
+
+#include "array.h"
+#include "cart.h"
+#include "logging.h"
+#include "messenger.h"
+#include "part.h"
+#include "romlist.h"
+#include "serialise.h"
+#include "ui.h"
+#include "xroar.h"
+
+#include "emesdos09/emes_fw.h"
+
+#define EMES_ROM_SIZE 16384
+#define EMES_BANK_SIZE 8192
+
+struct emesdos09 {
+	struct cart cart;
+	uint8_t rom[EMES_ROM_SIZE];
+	int msgr_client_id;
+};
+
+/* One SD card for the one controller model (the firmware keeps its state in
+ * globals, as firmware does). */
+static FILE *sd_image;
+static uint32_t sd_sectors;
+
+static const struct ser_struct ser_struct_emesdos09[] = {
+	SER_ID_STRUCT_NEST(1, &cart_ser_struct_data),
+};
+
+static const struct ser_struct_data emesdos09_ser_struct_data = {
+	.elems = ser_struct_emesdos09,
+	.num_elems = ARRAY_N_ELEMENTS(ser_struct_emesdos09),
+};
+
+static uint8_t emesdos09_read(struct cart *c, uint16_t A, bool P2, bool R2, uint8_t D);
+static uint8_t emesdos09_write(struct cart *c, uint16_t A, bool P2, bool R2, uint8_t D);
+static void emesdos09_reset(struct cart *c, bool hard);
+static void emesdos09_ui_set_hd_filename(void *sptr, int tag, void *smsg);
+
+static struct part *emesdos09_allocate(void);
+static void emesdos09_initialise(struct part *p, void *options);
+static bool emesdos09_finish(struct part *p);
+static void emesdos09_free(struct part *p);
+
+static const struct partdb_entry_funcs emesdos09_funcs = {
+	.allocate = emesdos09_allocate,
+	.initialise = emesdos09_initialise,
+	.finish = emesdos09_finish,
+	.free = emesdos09_free,
+
+	.ser_struct_data = &emesdos09_ser_struct_data,
+
+	.is_a = dragon_cart_is_a,
+};
+
+const struct cart_partdb_entry emesdos09_part = { .partdb_entry = { .name = "emesdos09", .description = "Carlos Camacho | emesDOS09 smart cartridge", .funcs = &emesdos09_funcs } };
+
+// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
+// The SD card: an image file.
+
+bool emes_host_read_sector(uint32_t lba, uint8_t *sector) {
+	if (!sd_image || lba >= sd_sectors) {
+		return false;
+	}
+	if (fseeko(sd_image, (off_t)lba * 512, SEEK_SET) != 0) {
+		return false;
+	}
+	return fread(sector, 1, 512, sd_image) == 512;
+}
+
+bool emes_host_write_sector(uint32_t lba, const uint8_t *sector) {
+	if (!sd_image || lba >= sd_sectors) {
+		return false;
+	}
+	if (fseeko(sd_image, (off_t)lba * 512, SEEK_SET) != 0) {
+		return false;
+	}
+	if (fwrite(sector, 1, 512, sd_image) != 512) {
+		return false;
+	}
+	fflush(sd_image);
+	return true;
+}
+
+static void sd_close(void) {
+	if (sd_image) {
+		fclose(sd_image);
+		sd_image = NULL;
+	}
+	sd_sectors = 0;
+}
+
+static void sd_open(const char *filename) {
+	sd_close();
+	bool wp = false;
+	if (filename) {
+		sd_image = fopen(filename, "r+b");
+		if (!sd_image) {
+			sd_image = fopen(filename, "rb");
+			wp = true;
+		}
+		if (sd_image && fseeko(sd_image, 0, SEEK_END) == 0) {
+			off_t size = ftello(sd_image);
+			sd_sectors = size > 0 ? (uint32_t)(size / 512) : 0;
+		}
+		if (!sd_image) {
+			LOG_MOD_WARN("emesdos09", "can't open SD image %s\n", filename);
+		} else {
+			LOG_MOD_PRINT("emesdos09", "SD card: %s (%u sectors%s)\n", filename, (unsigned)sd_sectors, wp ? ", read-only" : "");
+		}
+	}
+	emes_fw_set_media(sd_image != NULL, wp);
+}
+
+/* The controller's clock follows the host's. */
+static void set_rtc_from_host(void) {
+	time_t now = time(NULL);
+	struct tm *t = localtime(&now);
+	if (!t) {
+		return;
+	}
+	unsigned year = (unsigned)t->tm_year + 1900;
+	uint8_t rtc[8] = {
+		(uint8_t)(year >> 8), (uint8_t)year, (uint8_t)(t->tm_mon + 1), (uint8_t)t->tm_mday,
+		(uint8_t)t->tm_hour, (uint8_t)t->tm_min, (uint8_t)t->tm_sec, (uint8_t)t->tm_wday
+	};
+	emes_fw_set_rtc(rtc);
+}
+
+// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
+
+static struct part *emesdos09_allocate(void) {
+	struct emesdos09 *e = part_new(sizeof(*e));
+	struct cart *c = &e->cart;
+	struct part *p = &c->part;
+
+	*e = (struct emesdos09){0};
+
+	cart_rom_init(c);
+	c->read = emesdos09_read;
+	c->write = emesdos09_write;
+	c->reset = emesdos09_reset;
+
+	memset(e->rom, 0xff, sizeof(e->rom));
+	emes_fw_init();
+	emes_fw_trace = getenv("EMESDOS09_TRACE") != NULL;
+	return p;
+}
+
+static void emesdos09_initialise(struct part *p, void *options) {
+	cart_rom_initialise(p, options);
+}
+
+static bool emesdos09_finish(struct part *p) {
+	struct emesdos09 *e = (struct emesdos09 *)p;
+	struct cart *c = &e->cart;
+	struct cart_config *cc = c->config;
+
+	if (cc->rom) {
+		sds path = romlist_find(cc->rom);
+		FILE *f = path ? fopen(path, "rb") : NULL;
+		if (f) {
+			size_t n = fread(e->rom, 1, sizeof(e->rom), f);
+			fclose(f);
+			LOG_MOD_PRINT("emesdos09", "ROM: %s (%u bytes)\n", path, (unsigned)n);
+			if (n != EMES_ROM_SIZE) {
+				LOG_MOD_WARN("emesdos09", "ROM should be %d bytes (two 8K banks)\n", EMES_ROM_SIZE);
+			}
+		} else {
+			LOG_MOD_WARN("emesdos09", "ROM '%s' not found\n", cc->rom);
+		}
+		sdsfree(path);
+	}
+	if (!cart_rom_finish(p)) {
+		return 0;
+	}
+	set_rtc_from_host();
+	sd_open(xroar_hd_filename(0));
+
+	e->msgr_client_id = messenger_client_register();
+	ui_messenger_join_group(e->msgr_client_id, ui_tag_hd_filename, MESSENGER_NOTIFY_DELEGATE(emesdos09_ui_set_hd_filename, e));
+	return 1;
+}
+
+static void emesdos09_free(struct part *p) {
+	struct emesdos09 *e = (struct emesdos09 *)p;
+	messenger_client_unregister(e->msgr_client_id);
+	sd_close();
+	cart_rom_free(p);
+}
+
+static void emesdos09_ui_set_hd_filename(void *sptr, int tag, void *smsg) {
+	(void)sptr;
+	struct ui_state_message *uimsg = smsg;
+	assert(tag == ui_tag_hd_filename);
+	if (uimsg->value == 0) {
+		sd_open(uimsg->data);
+	}
+}
+
+static void emesdos09_reset(struct cart *c, bool hard) {
+	cart_rom_reset(c, hard);
+	if (hard) {
+		// Power cycle: bank 0, controller idle; the SD card stays in.
+		emes_fw_write(0x0, 0x00);
+		emes_fw_write(0xF, 0xFF);
+		set_rtc_from_host();
+	}
+}
+
+// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
+
+static uint8_t emesdos09_read(struct cart *c, uint16_t A, bool P2, bool R2, uint8_t D) {
+	struct emesdos09 *e = (struct emesdos09 *)c;
+	if (R2) {
+		return e->rom[emes_fw_bank() * EMES_BANK_SIZE + (A & (EMES_BANK_SIZE - 1))];
+	}
+	if (P2 && (A & 0xfff0) == 0xff40) {
+		return emes_fw_read(A & 15);
+	}
+	return D;
+}
+
+static uint8_t emesdos09_write(struct cart *c, uint16_t A, bool P2, bool R2, uint8_t D) {
+	(void)c;
+	(void)R2;
+	if (P2 && (A & 0xfff0) == 0xff40) {
+		emes_fw_write(A & 15, D);
+	}
+	return D;
+}
