+/* XRoar side of the emesDOS09 controller model (emes_fw.c). */
+#ifndef XROAR_EMESDOS09_EMES_FW_H_
+#define XROAR_EMESDOS09_EMES_FW_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+
+extern bool emes_fw_trace;
+void emes_fw_init(void);
+void emes_fw_set_media(bool present, bool write_protect);
+void emes_fw_set_rtc(const uint8_t rtc[8]);
+uint8_t emes_fw_bank(void);
+uint8_t emes_fw_read(unsigned reg);
+void emes_fw_write(unsigned reg, uint8_t value);
+
+/* Provided by the cartridge (emesdos09.c): 512-byte sectors of the SD image. */
+bool emes_host_read_sector(uint32_t lba, uint8_t *sector);
+bool emes_host_write_sector(uint32_t lba, const uint8_t *sector);
