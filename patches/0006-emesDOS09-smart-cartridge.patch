--- /dev/null
+++ b/src/emesdos09/fat16_ro.h
@@ -0,0 +1,126 @@
+#ifndef EMESDOS09_FAT16_RO_H
+#define EMESDOS09_FAT16_RO_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define EMES_FAT16_SECTOR_SIZE 512u
+#define EMES_FAT16_MAX_PATH 80u
+
+typedef bool (*emes_fat16_sector_reader_t)(uint32_t lba, uint8_t *sector, void *context);
+
+typedef enum {
+    EMES_FAT16_OK = 0,
+    EMES_FAT16_IO,
+    EMES_FAT16_INVALID,
+    EMES_FAT16_NOT_FOUND,
+    EMES_FAT16_PATH_NOT_FOUND,
+    EMES_FAT16_NO_MORE,
+    EMES_FAT16_SEEK
+} emes_fat16_result_t;
+
+typedef struct {
+    emes_fat16_sector_reader_t read_sector;
+    void *context;
+    uint32_t partition_lba;
+    uint32_t fat_lba;
+    uint32_t root_lba;
+    uint32_t data_lba;
+    uint32_t total_sectors;
+    uint32_t cluster_count;
+    uint16_t reserved_sectors;
+    uint16_t root_entries;
+    uint16_t root_dir_sectors;
+    uint16_t sectors_per_fat;
+    uint16_t bytes_per_sector;
+    uint8_t sectors_per_cluster;
+    uint8_t fat_count;
+    uint8_t flags;
+    uint32_t volume_serial;
+    char volume_label[12];
+} emes_fat16_volume_t;
+
+typedef struct {
+    uint8_t alias_raw[11];
+    uint8_t attributes;
+    uint8_t flags;
+    uint16_t create_time;
+    uint16_t create_date;
+    uint16_t write_time;
+    uint16_t write_date;
+    uint16_t first_cluster;
+    uint32_t size;
+} emes_fat16_entry_t;
+
+typedef struct {
+    uint16_t first_cluster;
+    uint32_t next_index;
+    bool root;
+    bool pending_lfn;
+    uint8_t pattern[11];
+} emes_fat16_dir_t;
+
+typedef struct {
+    emes_fat16_entry_t entry;
+    uint32_t position;
+} emes_fat16_file_t;
+
+typedef struct {
+    uint16_t bytes_per_sector;
+    uint16_t free_clusters;
+    uint16_t total_clusters;
+    uint8_t sectors_per_cluster;
+    uint32_t total_sectors;
+} emes_fat16_free_t;
+
+emes_fat16_result_t emes_fat16_mount(
+    emes_fat16_volume_t *volume,
+    emes_fat16_sector_reader_t reader,
+    void *context
+);
+emes_fat16_result_t emes_fat16_open_dir(
+    const emes_fat16_volume_t *volume,
+    const char *path_pattern,
+    emes_fat16_dir_t *directory
+);
+emes_fat16_result_t emes_fat16_dir_next(
+    const emes_fat16_volume_t *volume,
+    emes_fat16_dir_t *directory,
+    emes_fat16_entry_t *entry
+);
+emes_fat16_result_t emes_fat16_open_path(
+    const emes_fat16_volume_t *volume,
+    const char *path,
+    emes_fat16_file_t *file
+);
+emes_fat16_result_t emes_fat16_read(
+    const emes_fat16_volume_t *volume,
+    emes_fat16_file_t *file,
+    uint8_t *destination,
+    uint16_t requested,
+    uint16_t *actual
+);
+emes_fat16_result_t emes_fat16_seek(
+    emes_fat16_file_t *file,
+    uint32_t offset,
+    uint8_t whence
+);
+emes_fat16_result_t emes_fat16_free_space(
+    const emes_fat16_volume_t *volume,
+    emes_fat16_free_t *info
+);
+
+/* Sprint-6 compatibility wrappers. */
+emes_fat16_result_t emes_fat16_root_next(
+    const emes_fat16_volume_t *volume,
+    emes_fat16_dir_t *directory,
+    emes_fat16_entry_t *entry
+);
+emes_fat16_result_t emes_fat16_open_root(
+    const emes_fat16_volume_t *volume,
+    const char *path,
+    emes_fat16_file_t *file
+);
+
+#endif
diff --git a/src/emesdos09/fat16_rw.c b/src/emesdos09/fat16_rw.c
new file mode 100644
index 00000000..78d42540
--- /dev/null
+++ b/src/emesdos09/fat16_rw.c
@@ -0,0 +1,280 @@
+#include "fat16_rw.h"
+
+#include <string.h>
+
+static uint16_t le16(const uint8_t *data) {
+    return (uint16_t)data[0] | ((uint16_t)data[1] << 8);
+}
+
+static void put_le16(uint8_t *data, uint16_t value) {
+    data[0] = (uint8_t)value;
+    data[1] = (uint8_t)(value >> 8);
+}
+
+static void put_le32(uint8_t *data, uint32_t value) {
+    data[0] = (uint8_t)value;
+    data[1] = (uint8_t)(value >> 8);
+    data[2] = (uint8_t)(value >> 16);
+    data[3] = (uint8_t)(value >> 24);
+}
+
+static bool boundary(
+    emes_fat16_commit_boundary_t value,
+    emes_fat16_boundary_hook_t hook,
+    void *context,
+    emes_fat16_commit_result_t *result
+) {
+    result->last_boundary = value;
+    return hook == NULL || hook(value, context);
+}
+
+static emes_fat16_rw_result_t read_fat_entry(
+    const emes_fat16_volume_t *volume,
+    uint16_t cluster,
+    uint16_t *value
+) {
+    uint8_t sector[EMES_FAT16_SECTOR_SIZE];
+    const uint32_t byte_offset = (uint32_t)cluster * 2u;
+    const uint32_t lba = volume->fat_lba + byte_offset / EMES_FAT16_SECTOR_SIZE;
+    const uint16_t offset = (uint16_t)(byte_offset % EMES_FAT16_SECTOR_SIZE);
+    if (!volume->read_sector(lba, sector, volume->context)) return EMES_FAT16_RW_IO;
+    *value = le16(&sector[offset]);
+    return EMES_FAT16_RW_OK;
+}
+
+static emes_fat16_rw_result_t write_fat_entry(
+    const emes_fat16_volume_t *volume,
+    emes_fat16_sector_writer_t writer,
+    void *context,
+    uint8_t fat_copy,
+    uint16_t cluster,
+    uint16_t value
+) {
+    uint8_t sector[EMES_FAT16_SECTOR_SIZE];
+    const uint32_t byte_offset = (uint32_t)cluster * 2u;
+    const uint32_t lba = volume->fat_lba
+        + (uint32_t)fat_copy * volume->sectors_per_fat
+        + byte_offset / EMES_FAT16_SECTOR_SIZE;
+    const uint16_t offset = (uint16_t)(byte_offset % EMES_FAT16_SECTOR_SIZE);
+    if (!volume->read_sector(lba, sector, volume->context)) return EMES_FAT16_RW_IO;
+    put_le16(&sector[offset], value);
+    return writer(lba, sector, context) ? EMES_FAT16_RW_OK : EMES_FAT16_RW_IO;
+}
+
+static emes_fat16_rw_result_t allocate_clusters(
+    const emes_fat16_volume_t *volume,
+    uint16_t needed,
+    uint16_t *clusters
+) {
+    uint16_t found = 0u;
+    for (uint32_t cluster = 2u; cluster < volume->cluster_count + 2u && found < needed; ++cluster) {
+        uint16_t value = 0u;
+        emes_fat16_rw_result_t status = read_fat_entry(volume, (uint16_t)cluster, &value);
+        if (status != EMES_FAT16_RW_OK) return status;
+        if (value == 0u) clusters[found++] = (uint16_t)cluster;
+    }
+    return found == needed ? EMES_FAT16_RW_OK : EMES_FAT16_RW_NO_SPACE;
+}
+
+static emes_fat16_rw_result_t write_data_clusters(
+    const emes_fat16_volume_t *volume,
+    emes_fat16_sector_writer_t writer,
+    void *context,
+    const uint16_t *clusters,
+    uint16_t cluster_count,
+    const uint8_t *data,
+    uint32_t size,
+    emes_fat16_commit_result_t *result
+) {
+    uint8_t sector[EMES_FAT16_SECTOR_SIZE];
+    uint32_t position = 0u;
+    for (uint16_t index = 0u; index < cluster_count; ++index) {
+        const uint32_t first_lba = volume->data_lba
+            + ((uint32_t)clusters[index] - 2u) * volume->sectors_per_cluster;
+        for (uint8_t sector_index = 0u; sector_index < volume->sectors_per_cluster; ++sector_index) {
+            memset(sector, 0, sizeof(sector));
+            uint16_t copy = 0u;
+            if (position < size) {
+                const uint32_t remaining = size - position;
+                copy = remaining < sizeof(sector) ? (uint16_t)remaining : (uint16_t)sizeof(sector);
+                if (copy != 0u && data != NULL) memcpy(sector, &data[position], copy);
+                position += copy;
+            }
+            if (!writer(first_lba + sector_index, sector, context)) return EMES_FAT16_RW_IO;
+        }
+        ++result->data_cluster_writes;
+    }
+    return EMES_FAT16_RW_OK;
+}
+
+static emes_fat16_rw_result_t publish_new_chain(
+    const emes_fat16_volume_t *volume,
+    emes_fat16_sector_writer_t writer,
+    void *context,
+    const uint16_t *clusters,
+    uint16_t cluster_count,
+    uint8_t fat_copy,
+    emes_fat16_commit_result_t *result
+) {
+    for (uint16_t index = 0u; index < cluster_count; ++index) {
+        const uint16_t next = (index + 1u < cluster_count) ? clusters[index + 1u] : 0xFFFFu;
+        emes_fat16_rw_result_t status = write_fat_entry(
+            volume, writer, context, fat_copy, clusters[index], next
+        );
+        if (status != EMES_FAT16_RW_OK) return status;
+        ++result->fat_entry_writes;
+    }
+    return EMES_FAT16_RW_OK;
+}
+
+static emes_fat16_rw_result_t publish_directory(
+    const emes_fat16_volume_t *volume,
+    emes_fat16_sector_writer_t writer,
+    void *context,
+    const emes_fat16_commit_request_t *request,
+    uint16_t first_cluster,
+    emes_fat16_commit_result_t *result
+) {
+    uint8_t sector[EMES_FAT16_SECTOR_SIZE];
+    if (request->directory_offset > EMES_FAT16_SECTOR_SIZE - 32u ||
+        (request->directory_offset & 31u) != 0u) return EMES_FAT16_RW_INVALID;
+    if (!volume->read_sector(request->directory_lba, sector, volume->context)) {
+        return EMES_FAT16_RW_IO;
+    }
+    uint8_t *record = &sector[request->directory_offset];
+    memset(record, 0, 32u);
+    memcpy(record, request->alias_raw, 11u);
+    record[11] = (uint8_t)(request->attributes & 0x3Fu);
+    put_le16(&record[14], request->create_time);
+    put_le16(&record[16], request->create_date);
+    /* Deterministic Sprint 9 write timestamp: 2026-07-28 12:00:00. */
+    put_le16(&record[18], (uint16_t)(((2026u - 1980u) << 9) | (7u << 5) | 28u));
+    put_le16(&record[22], (uint16_t)(12u << 11));
+    put_le16(&record[24], (uint16_t)(((2026u - 1980u) << 9) | (7u << 5) | 28u));
+    put_le16(&record[26], first_cluster);
+    put_le32(&record[28], request->size);
+    if (!writer(request->directory_lba, sector, context)) return EMES_FAT16_RW_IO;
+    ++result->directory_entry_writes;
+    return EMES_FAT16_RW_OK;
+}
+
+static emes_fat16_rw_result_t release_old_chain(
+    const emes_fat16_volume_t *volume,
+    emes_fat16_sector_writer_t writer,
+    void *context,
+    uint16_t first_cluster,
+    emes_fat16_commit_result_t *result
+) {
+    uint16_t cluster = first_cluster;
+    uint32_t guard = 0u;
+    while (cluster >= 2u && cluster < 0xFFF8u && guard++ <= volume->cluster_count) {
+        uint16_t next = 0u;
+        emes_fat16_rw_result_t status = read_fat_entry(volume, cluster, &next);
+        if (status != EMES_FAT16_RW_OK) return status;
+        for (uint8_t copy = 0u; copy < volume->fat_count; ++copy) {
+            status = write_fat_entry(volume, writer, context, copy, cluster, 0u);
+            if (status != EMES_FAT16_RW_OK) return status;
+            ++result->fat_entry_writes;
+        }
+        ++result->released_clusters;
+        cluster = next;
+    }
+    return guard > volume->cluster_count + 1u ? EMES_FAT16_RW_INVALID : EMES_FAT16_RW_OK;
+}
+
+static emes_fat16_rw_result_t verify_data(
+    const emes_fat16_volume_t *volume,
+    const uint16_t *clusters,
+    uint16_t cluster_count,
+    const uint8_t *data,
+    uint32_t size
+) {
+    uint8_t sector[EMES_FAT16_SECTOR_SIZE];
+    uint32_t position = 0u;
+    for (uint16_t index = 0u; index < cluster_count; ++index) {
+        const uint32_t first_lba = volume->data_lba
+            + ((uint32_t)clusters[index] - 2u) * volume->sectors_per_cluster;
+        for (uint8_t sector_index = 0u; sector_index < volume->sectors_per_cluster && position < size; ++sector_index) {
+            if (!volume->read_sector(first_lba + sector_index, sector, volume->context)) {
+                return EMES_FAT16_RW_IO;
+            }
+            const uint32_t remaining = size - position;
+            const uint16_t compare = remaining < sizeof(sector) ? (uint16_t)remaining : (uint16_t)sizeof(sector);
+            if (compare != 0u && data != NULL && memcmp(sector, &data[position], compare) != 0) {
+                return EMES_FAT16_RW_VERIFY_FAILED;
+            }
+            position += compare;
+        }
+    }
+    return EMES_FAT16_RW_OK;
+}
+
+emes_fat16_rw_result_t emes_fat16_rw_commit(
+    const emes_fat16_volume_t *volume,
+    emes_fat16_sector_writer_t writer,
+    void *io_context,
+    const emes_fat16_commit_request_t *request,
+    emes_fat16_boundary_hook_t boundary_hook,
+    void *boundary_context,
+    emes_fat16_commit_result_t *result
+) {
+    if (volume == NULL || writer == NULL || request == NULL || result == NULL ||
+        volume->bytes_per_sector != EMES_FAT16_SECTOR_SIZE || volume->fat_count == 0u) {
+        return EMES_FAT16_RW_INVALID;
+    }
+    if (request->write_protect) return EMES_FAT16_RW_WRITE_PROTECT;
+    memset(result, 0, sizeof(*result));
+
+    const uint32_t cluster_bytes = (uint32_t)volume->sectors_per_cluster * EMES_FAT16_SECTOR_SIZE;
+    const uint32_t needed32 = request->size == 0u ? 0u : (request->size + cluster_bytes - 1u) / cluster_bytes;
+    if (needed32 > EMES_FAT16_RW_MAX_CLUSTERS) return EMES_FAT16_RW_NO_SPACE;
+    const uint16_t needed = (uint16_t)needed32;
+    uint16_t clusters[EMES_FAT16_RW_MAX_CLUSTERS];
+    memset(clusters, 0, sizeof(clusters));
+
+    emes_fat16_rw_result_t status = allocate_clusters(volume, needed, clusters);
+    if (status != EMES_FAT16_RW_OK) return status;
+    result->allocated_clusters = needed;
+    result->first_cluster = needed == 0u ? 0u : clusters[0];
+
+    status = write_data_clusters(
+        volume, writer, io_context, clusters, needed, request->data, request->size, result
+    );
+    if (status != EMES_FAT16_RW_OK) return status;
+    if (!boundary(EMES_FAT16_COMMIT_AFTER_DATA, boundary_hook, boundary_context, result)) {
+        return EMES_FAT16_RW_POWER_LOSS;
+    }
+
+    for (uint8_t copy = 0u; copy < volume->fat_count; ++copy) {
+        status = publish_new_chain(volume, writer, io_context, clusters, needed, copy, result);
+        if (status != EMES_FAT16_RW_OK) return status;
+        const emes_fat16_commit_boundary_t phase = copy == 0u
+            ? EMES_FAT16_COMMIT_AFTER_FAT_COPY_0
+            : EMES_FAT16_COMMIT_AFTER_FAT_COPY_1;
+        if (!boundary(phase, boundary_hook, boundary_context, result)) {
+            return EMES_FAT16_RW_POWER_LOSS;
+        }
+    }
+
+    status = publish_directory(volume, writer, io_context, request, result->first_cluster, result);
+    if (status != EMES_FAT16_RW_OK) return status;
+    if (!boundary(EMES_FAT16_COMMIT_AFTER_DIRECTORY, boundary_hook, boundary_context, result)) {
+        return EMES_FAT16_RW_POWER_LOSS;
+    }
+
+    status = release_old_chain(volume, writer, io_context, request->old_first_cluster, result);
+    if (status != EMES_FAT16_RW_OK) return status;
+    if (!boundary(EMES_FAT16_COMMIT_AFTER_CLEANUP, boundary_hook, boundary_context, result)) {
+        return EMES_FAT16_RW_POWER_LOSS;
+    }
+
+    if (request->verify) {
+        status = verify_data(volume, clusters, needed, request->data, request->size);
+        if (status != EMES_FAT16_RW_OK) return status;
+        ++result->verify_passes;
+    }
+    if (!boundary(EMES_FAT16_COMMIT_AFTER_VERIFY, boundary_hook, boundary_context, result)) {
+        return EMES_FAT16_RW_POWER_LOSS;
+    }
+    return EMES_FAT16_RW_OK;
+}
diff --git a/src/emesdos09/fat16_rw.h b/src/emesdos09/fat16_rw.h
new file mode 100644
index 00000000..23d7f128
--- /dev/null
+++ b/src/emesdos09/fat16_rw.h
@@ -0,0 +1,77 @@
+#ifndef EMESDOS09_FAT16_RW_H
+#define EMESDOS09_FAT16_RW_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "fat16_ro.h"
+
+#define EMES_FAT16_RW_MAX_CLUSTERS 256u
+
+typedef bool (*emes_fat16_sector_writer_t)(uint32_t lba, const uint8_t *sector, void *context);
+
+typedef enum {
+    EMES_FAT16_COMMIT_AFTER_DATA = 0,
+    EMES_FAT16_COMMIT_AFTER_FAT_COPY_0,
+    EMES_FAT16_COMMIT_AFTER_FAT_COPY_1,
+    EMES_FAT16_COMMIT_AFTER_DIRECTORY,
+    EMES_FAT16_COMMIT_AFTER_CLEANUP,
+    EMES_FAT16_COMMIT_AFTER_VERIFY
+} emes_fat16_commit_boundary_t;
+
+typedef bool (*emes_fat16_boundary_hook_t)(emes_fat16_commit_boundary_t boundary, void *context);
+
+typedef enum {
+    EMES_FAT16_RW_OK = 0,
+    EMES_FAT16_RW_IO,
+    EMES_FAT16_RW_INVALID,
+    EMES_FAT16_RW_NO_SPACE,
+    EMES_FAT16_RW_WRITE_PROTECT,
+    EMES_FAT16_RW_POWER_LOSS,
+    EMES_FAT16_RW_VERIFY_FAILED
+} emes_fat16_rw_result_t;
+
+typedef struct {
+    uint32_t directory_lba;
+    uint16_t directory_offset;
+    uint16_t old_first_cluster;
+    uint8_t alias_raw[11];
+    uint8_t attributes;
+    uint16_t create_time;
+    uint16_t create_date;
+    const uint8_t *data;
+    uint32_t size;
+    bool verify;
+    bool write_protect;
+} emes_fat16_commit_request_t;
+
+typedef struct {
+    uint16_t first_cluster;
+    uint16_t allocated_clusters;
+    uint16_t released_clusters;
+    uint16_t data_cluster_writes;
+    uint16_t fat_entry_writes;
+    uint16_t directory_entry_writes;
+    uint16_t verify_passes;
+    emes_fat16_commit_boundary_t last_boundary;
+} emes_fat16_commit_result_t;
+
+/*
+ * Commit a complete replacement file image using metadata-last copy-on-write.
+ * The caller resolves the DOS path and supplies the short-directory-entry
+ * location. The engine allocates fresh clusters, writes all data, publishes
+ * every FAT copy, publishes the directory record, and only then releases the
+ * old chain. Directory growth is a Sprint 10 responsibility.
+ */
+emes_fat16_rw_result_t emes_fat16_rw_commit(
+    const emes_fat16_volume_t *volume,
+    emes_fat16_sector_writer_t writer,
+    void *io_context,
+    const emes_fat16_commit_request_t *request,
+    emes_fat16_boundary_hook_t boundary_hook,
+    void *boundary_context,
+    emes_fat16_commit_result_t *result
+);
+
+#endif
diff --git a/src/emesdos09/ide_image.c b/src/emesdos09/ide_image.c
new file mode 100644
index 00000000..6fb25fd2
--- /dev/null
+++ b/src/emesdos09/ide_image.c
@@ -0,0 +1,70 @@
+#include "ide_image.h"
+#include <string.h>
+
+static void put_le16(uint8_t *p, uint16_t value) {
+    p[0] = (uint8_t)value;
+    p[1] = (uint8_t)(value >> 8);
+}
+
+static void ata_string(uint8_t *out, uint16_t word, uint16_t words, const char *text) {
+    size_t length = strlen(text);
+    size_t limit = (size_t)words * 2u;
+    for (size_t i = 0u; i < limit; i += 2u) {
+        uint8_t first = i < length ? (uint8_t)text[i] : (uint8_t)' ';
+        uint8_t second = i + 1u < length ? (uint8_t)text[i + 1u] : (uint8_t)' ';
+        out[word * 2u + i] = second;
+        out[word * 2u + i + 1u] = first;
+    }
+}
+
+bool emes_ide_attach(emes_ide_image_t *ide, uint8_t unit, uint32_t byte_size, bool read_only) {
+    if (ide == NULL || unit > 1u || byte_size < 64u * 512u || (byte_size % 512u) != 0u)
+        return false;
+    memset(ide, 0, sizeof(*ide));
+    ide->unit = unit;
+    ide->attached = true;
+    ide->read_only = read_only;
+    ide->sectors = byte_size / 512u;
+    ide->heads = 16u;
+    ide->sectors_per_track = 63u;
+    uint32_t cylinders = (ide->sectors + 1007u) / 1008u;
+    if (cylinders == 0u) cylinders = 1u;
+    if (cylinders > 16383u) cylinders = 16383u;
+    ide->cylinders = (uint16_t)cylinders;
+    return true;
+}
+
+bool emes_ide_read_half(const emes_ide_image_t *ide, uint32_t lba, uint8_t half,
+                        uint8_t out[256], emes_ide_reader_t reader, void *context) {
+    if (ide == NULL || !ide->attached || lba >= ide->sectors || half > 1u ||
+        out == NULL || reader == NULL)
+        return false;
+    return reader(lba * 512u + (uint32_t)half * 256u, out, 256u, context);
+}
+
+bool emes_ide_write_half(emes_ide_image_t *ide, uint32_t lba, uint8_t half,
+                         const uint8_t data[256], emes_ide_writer_t writer, void *context) {
+    if (ide == NULL || !ide->attached || ide->read_only || lba >= ide->sectors ||
+        half > 1u || data == NULL || writer == NULL)
+        return false;
+    if (!writer(lba * 512u + (uint32_t)half * 256u, data, 256u, context))
+        return false;
+    ide->dirty = true;
+    return true;
+}
+
+void emes_ide_identify(const emes_ide_image_t *ide, uint8_t out[512]) {
+    memset(out, 0, 512u);
+    if (ide == NULL || !ide->attached) return;
+    put_le16(out + 0, 0x0040u);
+    put_le16(out + 2, ide->cylinders);
+    put_le16(out + 6, ide->heads);
+    put_le16(out + 12, ide->sectors_per_track);
+    put_le16(out + 98, 0x0200u);
+    put_le16(out + 120, (uint16_t)ide->sectors);
+    put_le16(out + 122, (uint16_t)(ide->sectors >> 16));
+    put_le16(out + 164, 0x0020u);
+    put_le16(out + 170, 0x0020u);
+    ata_string(out, 23u, 4u, "0.16.0");
+    ata_string(out, 27u, 20u, ide->unit ? "emesDOS09 VIRTUAL IDE1" : "emesDOS09 VIRTUAL IDE0");
+}
diff --git a/src/emesdos09/ide_image.h b/src/emesdos09/ide_image.h
new file mode 100644
index 00000000..78daad7c
--- /dev/null
+++ b/src/emesdos09/ide_image.h
@@ -0,0 +1,28 @@
+#ifndef EMESDOS09_IDE_IMAGE_H
+#define EMESDOS09_IDE_IMAGE_H
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#define EMES_IDE_SECTOR_SIZE 512u
+#define EMES_IDE_HALF_SIZE 256u
+#define EMES_IDE_MAX_EXTENTS 64u
+typedef struct { uint32_t first_lba; uint32_t sectors; } emes_ide_extent_t;
+typedef struct {
+    uint8_t unit;
+    bool attached;
+    bool read_only;
+    bool dirty;
+    uint32_t sectors;
+    uint16_t cylinders;
+    uint8_t heads;
+    uint8_t sectors_per_track;
+    uint16_t extent_count;
+    emes_ide_extent_t extents[EMES_IDE_MAX_EXTENTS];
+} emes_ide_image_t;
+typedef bool (*emes_ide_reader_t)(uint32_t offset, uint8_t *data, uint16_t length, void *context);
+typedef bool (*emes_ide_writer_t)(uint32_t offset, const uint8_t *data, uint16_t length, void *context);
+bool emes_ide_attach(emes_ide_image_t *ide, uint8_t unit, uint32_t byte_size, bool read_only);
+bool emes_ide_read_half(const emes_ide_image_t *ide, uint32_t lba, uint8_t half, uint8_t out[EMES_IDE_HALF_SIZE], emes_ide_reader_t reader, void *context);
+bool emes_ide_write_half(emes_ide_image_t *ide, uint32_t lba, uint8_t half, const uint8_t data[EMES_IDE_HALF_SIZE], emes_ide_writer_t writer, void *context);
+void emes_ide_identify(const emes_ide_image_t *ide, uint8_t out[EMES_IDE_SECTOR_SIZE]);
+#endif
diff --git a/src/emesdos09/partition_fat.c b/src/emesdos09/partition_fat.c
new file mode 100644
index 00000000..d6d3e7ad
--- /dev/null
+++ b/src/emesdos09/partition_fat.c
@@ -0,0 +1,82 @@
+#include "partition_fat.h"
+#include <string.h>
+
+static uint16_t le16(const uint8_t *p) { return (uint16_t)p[0] | (uint16_t)((uint16_t)p[1] << 8); }
+static uint32_t le32(const uint8_t *p) { return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24); }
+static void put16(uint8_t *p, uint16_t v) { p[0]=(uint8_t)v; p[1]=(uint8_t)(v>>8); }
+static void put32(uint8_t *p, uint32_t v) { p[0]=(uint8_t)v; p[1]=(uint8_t)(v>>8); p[2]=(uint8_t)(v>>16); p[3]=(uint8_t)(v>>24); }
+static bool supported_type(uint8_t type) {
+    return type==0x01u || type==0x04u || type==0x06u || type==0x0Eu || type==0x0Bu || type==0x0Cu;
+}
+
+bool emes_mbr_enumerate(const uint8_t sector[512], uint32_t ide_sectors,
+                        emes_mbr_partition_t out[4], size_t *count) {
+    if (sector==NULL || out==NULL || count==NULL || sector[510]!=0x55u || sector[511]!=0xAAu) return false;
+    size_t used=0u;
+    for (uint8_t i=0u;i<4u;i++) {
+        const uint8_t *e=sector+446u+(uint16_t)i*16u;
+        uint8_t status=e[0], type=e[4]; uint32_t first=le32(e+8), sectors=le32(e+12);
+        if (type==0u || sectors==0u) continue;
+        if ((status!=0u && status!=0x80u) || first==0u || first>ide_sectors || sectors>ide_sectors-first) return false;
+        for (size_t j=0u;j<used;j++) {
+            uint32_t a0=out[j].first_lba, a1=a0+out[j].sectors;
+            uint32_t b0=first, b1=first+sectors;
+            if (a0<b1 && b0<a1) return false;
+        }
+        out[used].index=i; out[used].bootable=status==0x80u; out[used].type=type;
+        out[used].first_lba=first; out[used].sectors=sectors; used++;
+    }
+    *count=used; return true;
+}
+
+bool emes_mbr_create_primary(uint8_t sector[512], uint32_t ide_sectors, uint8_t index,
+                             uint32_t first_lba, uint32_t sectors, uint8_t type, bool bootable) {
+    if (sector==NULL || index>=4u || !supported_type(type) || first_lba==0u || sectors<64u ||
+        first_lba>ide_sectors || sectors>ide_sectors-first_lba) return false;
+    uint8_t candidate[512]; memcpy(candidate,sector,512u); candidate[510]=0x55u; candidate[511]=0xAAu;
+    uint8_t *e=candidate+446u+(uint16_t)index*16u; memset(e,0,16u);
+    e[0]=bootable?0x80u:0u; e[1]=1u; e[2]=1u; e[4]=type; e[5]=0xFEu; e[6]=0xFFu; e[7]=0xFFu;
+    put32(e+8,first_lba); put32(e+12,sectors);
+    emes_mbr_partition_t parts[4]; size_t count=0u;
+    if (!emes_mbr_enumerate(candidate,ide_sectors,parts,&count)) return false;
+    memcpy(sector,candidate,512u); return true;
+}
+
+bool emes_fat_probe(const uint8_t boot[512], uint32_t partition_sectors, emes_fat_probe_t *out) {
+    if (boot==NULL || out==NULL || boot[510]!=0x55u || boot[511]!=0xAAu || le16(boot+11)!=512u) return false;
+    uint8_t spc=boot[13], fats=boot[16]; uint16_t reserved=le16(boot+14), roots=le16(boot+17);
+    uint32_t total=le16(boot+19); if (total==0u) total=le32(boot+32);
+    uint32_t spf=le16(boot+22); if (spf==0u) spf=le32(boot+36);
+    if (spc==0u || reserved==0u || fats==0u || spf==0u || total==0u || total>partition_sectors) return false;
+    uint32_t root_sectors=((uint32_t)roots*32u+511u)/512u;
+    uint32_t overhead=(uint32_t)reserved+(uint32_t)fats*spf+root_sectors;
+    if (overhead>=total) return false;
+    uint32_t clusters=(total-overhead)/spc; emes_fat_kind_t kind;
+    if (roots==0u) kind=EMES_FAT32; else if (clusters<4085u) kind=EMES_FAT12; else if (clusters<=65524u) kind=EMES_FAT16; else return false;
+    out->kind=kind; out->read_only=kind==EMES_FAT32; out->sectors_per_cluster=spc;
+    out->reserved_sectors=reserved; out->fat_count=fats; out->root_entries=roots;
+    out->sectors_per_fat=spf; out->total_sectors=total; out->cluster_count=clusters; return true;
+}
+
+bool emes_fat_format_boot(uint8_t boot[512], uint32_t total, emes_fat_kind_t kind,
+                          uint32_t hidden, const char *label, emes_fat_format_layout_t *layout) {
+    if (boot==NULL || layout==NULL || (kind!=EMES_FAT12 && kind!=EMES_FAT16) || total<256u) return false;
+    uint16_t roots=kind==EMES_FAT12?224u:512u; uint16_t root_sectors=(uint16_t)(((uint32_t)roots*32u+511u)/512u);
+    uint16_t spf=1u; uint32_t clusters=0u;
+    for (uint8_t pass=0u;pass<16u;pass++) {
+        uint32_t overhead=1u+2u*(uint32_t)spf+(uint32_t)root_sectors; if (overhead>=total) return false;
+        clusters=total-overhead;
+        uint32_t fat_bytes=kind==EMES_FAT12?((clusters+2u)*3u+1u)/2u:(clusters+2u)*2u;
+        uint16_t next=(uint16_t)((fat_bytes+511u)/512u); if (next==spf) break; spf=next;
+    }
+    if ((kind==EMES_FAT12 && clusters>=4085u) || (kind==EMES_FAT16 && (clusters<4085u || clusters>65524u))) return false;
+    memset(boot,0,512u); boot[0]=0xEBu; boot[1]=0x3Cu; boot[2]=0x90u; memcpy(boot+3,"EMESDOS9",8u);
+    put16(boot+11,512u); boot[13]=1u; put16(boot+14,1u); boot[16]=2u; put16(boot+17,roots);
+    if (total<65536u) put16(boot+19,(uint16_t)total); else put32(boot+32,total);
+    boot[21]=0xF8u; put16(boot+22,spf); put16(boot+24,63u); put16(boot+26,16u); put32(boot+28,hidden);
+    boot[36]=0x80u; boot[38]=0x29u; put32(boot+39,0xE9240010u);
+    memset(boot+43,' ',11u); if (label!=NULL) { for (uint8_t i=0u;i<11u && label[i]!='\0';i++) boot[43+i]=(uint8_t)label[i]; }
+    memcpy(boot+54,kind==EMES_FAT12?"FAT12   ":"FAT16   ",8u); boot[510]=0x55u; boot[511]=0xAAu;
+    layout->root_entries=roots; layout->root_sectors=root_sectors; layout->sectors_per_fat=spf; layout->sectors_per_cluster=1u;
+    return true;
+}
