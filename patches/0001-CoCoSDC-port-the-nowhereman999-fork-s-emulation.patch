+static void strip_root_quotes(char *s) {
+	size_t n;
+	if (!s || s[0] == 0) {
+		return;
+	}
+	n = strlen(s);
+	if (n >= 2 && ((s[0] == '"' && s[n - 1] == '"') || (s[0] == '\'' && s[n - 1] == '\''))) {
+		memmove(s, s + 1, n - 2);
+		s[n - 2] = 0;
+	}
+}
