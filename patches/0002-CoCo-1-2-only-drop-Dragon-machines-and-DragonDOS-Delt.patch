From f8fd84ba4a18c7f97927ad5ea9793a537d03689a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 17:44:31 +0000
Subject: [PATCH] CoCo 1/2 only: drop Dragon machines and DragonDOS/Delta carts

The Android build targets the Tandy Colour Computer 1 and 2.

- xroar.c: remove the Dragon 32/64, Tano, Dragon Pro, Dragon 200-E and
  Dragon 64 + SAMx8 machine definitions, and the dragondos and delta carts;
  add 'default-machine cocous' to the built-in configuration.
- machine.c: machine_config_first_working() prefers cocous, not dragon64.
- part.c, Makefile.am: stop building dragon32/dragon64/dragonpro and
  dragondos/deltados.

CoCo 3 and MC-10 are left out at configure time (--disable-coco3
--disable-mc10), not by this patch.
---
 src/Makefile.am |  7 +------
 src/machine.c   |  8 +++-----
 src/part.c      | 11 -----------
 src/xroar.c     | 51 ++-----------------------------------------------
 4 files changed, 6 insertions(+), 71 deletions(-)

diff --git a/src/Makefile.am b/src/Makefile.am
index 91e195cc..3690b694 100644
--- a/src/Makefile.am
+++ b/src/Makefile.am
@@ -77,10 +77,7 @@ xroar_SOURCES += \
 	dragon/coco.c dragon/coco.h \
 	dragon/immunity.c dragon/immunity.h \
 	dragon/deluxecoco.c \
-	dragon/dragon.c dragon/dragon.h \
-	dragon/dragon32.c \
-	dragon/dragon64.c \
-	dragon/dragonpro.c
+	dragon/dragon.c dragon/dragon.h
 endif
 
 if MACHINE_ARCH_COCO3
@@ -130,8 +127,6 @@ endif
 
 if CART_ARCH_DRAGON
 xroar_SOURCES += \
-	deltados.c \
-	dragondos.c \
 	gmc.c \
 	ide.c ide.h \
 	idecart.c \
diff --git a/src/machine.c b/src/machine.c
index 12f23cc6..1bd88430 100644
--- a/src/machine.c
+++ b/src/machine.c
@@ -279,10 +279,8 @@ static bool machine_is_working_config(struct machine_config *mc) {
 }
 
 struct machine_config *machine_config_first_working(void) {
-	// dragon64 might not be first in the list, but it's been the first one
-	// tested for the whole time, so avoid unexpected behaviour by checking
-	// it first.
-	struct machine_config *d64_mc = machine_config_by_name("dragon64");
+	// This build has no Dragons: check the NTSC CoCo first.
+	struct machine_config *d64_mc = machine_config_by_name("cocous");
 	if (machine_is_working_config(d64_mc))
 		return d64_mc;
 	// otherwise, work through the list
@@ -291,7 +289,7 @@ struct machine_config *machine_config_first_working(void) {
 		if (machine_is_working_config(mc))
 			return mc;
 	}
-	// and if none found, just return the non-working dragon64 one
+	// and if none found, just return the non-working cocous one
 	if (d64_mc)
 		return d64_mc;
 	assert(config_list != NULL);
diff --git a/src/part.c b/src/part.c
index 6256d4de..897242a8 100644
--- a/src/part.c
+++ b/src/part.c
