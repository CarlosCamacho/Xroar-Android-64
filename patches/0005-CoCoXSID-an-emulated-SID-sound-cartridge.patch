diff --git a/src/sid.c b/src/sid.c
new file mode 100644
index 00000000..1bf18ffd
--- /dev/null
+++ b/src/sid.c
@@ -0,0 +1,260 @@
+/* MOS 6581 "SID" sound chip.  See sid.h.
+ *
+ * Copyright 2026
+ *
+ * This file is part of XRoar, a Dragon/Tandy CoCo emulator.
+ * GPL-3.0-or-later; see COPYING.GPL.
+ */
+
+#include "top-config.h"
+
+#include <math.h>
+#include <string.h>
+
+#include "sid.h"
+
+enum { CTRL_GATE = 1, CTRL_SYNC = 2, CTRL_RING = 4, CTRL_TEST = 8,
+       CTRL_TRI = 0x10, CTRL_SAW = 0x20, CTRL_PULSE = 0x40, CTRL_NOISE = 0x80 };
+enum { ENV_ATTACK, ENV_DECAY, ENV_RELEASE };
+
+// Clock cycles per envelope step, for nibble values 0-15 (data sheet times:
+// attack 2 ms .. 8 s at 1 MHz).
+static const uint16_t rate_periods[16] = {
+	9, 32, 63, 95, 149, 220, 267, 313, 392, 977, 1954, 3126, 3907, 11720, 19532, 31251
+};
+
+// Decay and release are exponential: the envelope steps only every
+// exp_period-th rate tick, with a longer period as the level falls.
+static unsigned exp_period_for(unsigned env) {
+	if (env == 0xff) return 1;
+	if (env > 93) return 1;
+	if (env > 54) return 2;
+	if (env > 26) return 4;
+	if (env > 14) return 8;
+	if (env > 6) return 16;
+	if (env > 0) return 30;
+	return 1;
+}
+
+void sid_init(struct sid *s, unsigned clock_hz, unsigned sample_rate) {
+	memset(s, 0, sizeof(*s));
+	s->clock_hz = clock_hz;
+	s->sample_rate = sample_rate;
+	sid_reset(s);
+}
+
+void sid_reset(struct sid *s) {
+	for (int i = 0; i < 3; i++) {
+		struct sid_voice *v = &s->v[i];
+		memset(v, 0, sizeof(*v));
+		v->lfsr = 0x7fffff;
+		v->state = ENV_RELEASE;
+		v->rate_period = rate_periods[0];
+		v->exp_period = 1;
+		v->hold_zero = 1;
+	}
+	s->cutoff_lo = s->cutoff_hi = s->res_filt = s->mode_vol = 0;
+	s->lp = s->bp = 0.0f;
+	s->cycle_error = 0;
+}
+
+static void gate_change(struct sid_voice *v, int gate) {
+	if (gate && !v->gate) {
+		v->state = ENV_ATTACK;
+		v->rate_period = rate_periods[v->ad >> 4];
+		v->hold_zero = 0;
+	} else if (!gate && v->gate) {
+		v->state = ENV_RELEASE;
+		v->rate_period = rate_periods[v->sr & 15];
+	}
+	v->gate = gate;
+}
+
+void sid_write(struct sid *s, unsigned reg, uint8_t d) {
+	reg &= 0x1f;
+	if (reg < 0x15) {
+		struct sid_voice *v = &s->v[reg / 7];
+		switch (reg % 7) {
+		case 0: v->freq = (v->freq & 0xff00) | d; break;
+		case 1: v->freq = (v->freq & 0x00ff) | (d << 8); break;
+		case 2: v->pw = (v->pw & 0x0f00) | d; break;
+		case 3: v->pw = (v->pw & 0x00ff) | ((d & 0x0f) << 8); break;
+		case 4:
+			v->ctrl = d;
+			gate_change(v, d & CTRL_GATE);
+			break;
+		case 5:
+			v->ad = d;
+			if (v->state == ENV_ATTACK) v->rate_period = rate_periods[d >> 4];
+			break;
+		case 6:
+			v->sr = d;
+			if (v->state == ENV_RELEASE) v->rate_period = rate_periods[d & 15];
+			break;
+		}
+		return;
+	}
+	switch (reg) {
+	case 0x15: s->cutoff_lo = d & 7; break;
+	case 0x16: s->cutoff_hi = d; break;
+	case 0x17: s->res_filt = d; break;
+	case 0x18: s->mode_vol = d; break;
+	default: break;
+	}
+}
+
+// 12-bit waveform output for a voice, 0 if no waveform is selected.
+static unsigned wave(const struct sid *s, int i) {
+	const struct sid_voice *v = &s->v[i];
+	const struct sid_voice *src = &s->v[(i + 2) % 3];  // ring/sync source
+	unsigned sel = v->ctrl & 0xf0;
+	if (!sel) return 0;
+	unsigned out = 0xfff;
+	if (sel & CTRL_TRI) {
+		unsigned x = (v->acc >> 11) & 0xfff;
+		unsigned msb = (v->acc >> 23) & 1;
+		if (v->ctrl & CTRL_RING) msb ^= (src->acc >> 23) & 1;
+		if (msb) x ^= 0xfff;
+		out &= x;
+	}
+	if (sel & CTRL_SAW) {
+		out &= (v->acc >> 12) & 0xfff;
+	}
+	if (sel & CTRL_PULSE) {
+		// duty cycle is PW/4096, as in the data sheet
+		out &= (((v->acc >> 12) & 0xfff) < v->pw || (v->ctrl & CTRL_TEST)) ? 0xfff : 0;
+	}
+	if (sel & CTRL_NOISE) {
+		uint32_t l = v->lfsr;
+		unsigned n = ((l >> 22) & 1) << 11 | ((l >> 20) & 1) << 10 | ((l >> 16) & 1) << 9 |
+		             ((l >> 13) & 1) << 8 | ((l >> 11) & 1) << 7 | ((l >> 7) & 1) << 6 |
+		             ((l >> 4) & 1) << 5 | ((l >> 2) & 1) << 4;
+		out &= n;
+	}
+	return out;
+}
+
+uint8_t sid_read(struct sid *s, unsigned reg) {
+	switch (reg & 0x1f) {
+	case 0x19:
+	case 0x1a: return 0xff;
+	case 0x1b: return (uint8_t)(wave(s, 2) >> 4);
+	case 0x1c: return s->v[2].env;
+	default: return 0;
+	}
+}
+
+static void envelope_cycle(struct sid_voice *v) {
+	if (++v->rate_counter < v->rate_period) return;
+	v->rate_counter = 0;
+	if (v->state != ENV_ATTACK && ++v->exp_counter < v->exp_period) return;
+	v->exp_counter = 0;
+	if (v->hold_zero) return;
+	switch (v->state) {
+	case ENV_ATTACK:
+		if (++v->env == 0xff) {
+			v->state = ENV_DECAY;
+			v->rate_period = rate_periods[v->ad & 15];
+		}
+		break;
+	case ENV_DECAY:
+		if (v->env != (unsigned)(v->sr >> 4) * 17 && v->env > 0) {
+			if (v->env > (unsigned)(v->sr >> 4) * 17) --v->env;
+		}
+		break;
+	case ENV_RELEASE:
+		if (v->env > 0) --v->env;
+		break;
+	}
+	v->exp_period = exp_period_for(v->env);
+	if (v->env == 0 && v->state != ENV_ATTACK) v->hold_zero = 1;
+}
+
+// One chip clock cycle for all three voices.
+static void cycle(struct sid *s) {
+	for (int i = 0; i < 3; i++) {
+		struct sid_voice *v = &s->v[i];
+		v->msb_rise = 0;
+		if (v->ctrl & CTRL_TEST) {
+			v->acc = 0;
+			v->lfsr = 0x7fffff;
+		} else {
+			uint32_t old = v->acc;
+			v->acc = (old + v->freq) & 0xffffff;
+			if (!(old & 0x800000) && (v->acc & 0x800000)) v->msb_rise = 1;
+			if (!(old & 0x80000) && (v->acc & 0x80000)) {
+				unsigned bit = ((v->lfsr >> 22) ^ (v->lfsr >> 17)) & 1;
+				v->lfsr = ((v->lfsr << 1) & 0x7fffff) | bit;
+			}
+		}
+	}
+	// hard sync: a voice's phase restarts when its source rolls over
+	for (int i = 0; i < 3; i++) {
+		struct sid_voice *v = &s->v[i];
+		if ((v->ctrl & CTRL_SYNC) && s->v[(i + 2) % 3].msb_rise && !(v->ctrl & CTRL_TEST)) {
+			v->acc = 0;
+		}
+		envelope_cycle(v);
+	}
+}
+
+void sid_render(struct sid *s, float *out, int nframes) {
+	const unsigned vol = s->mode_vol & 15;
+	const unsigned cutoff = ((unsigned)s->cutoff_hi << 3) | s->cutoff_lo;     // 11 bits
+	const unsigned res = s->res_filt >> 4;
+	float fc_hz = 30.0f + cutoff * 5.8f;                                       // ~30 Hz .. ~12 kHz
+	if (fc_hz > 0.45f * s->sample_rate) fc_hz = 0.45f * s->sample_rate;
+	const float g = tanf(3.14159265f * fc_hz / s->sample_rate);
+	const float k = 1.4f - 1.25f * res / 15.0f;                                 // resonance lowers damping
+	const float a1 = 1.0f / (1.0f + g * (g + k)), a2 = g * a1, a3 = g * a2;
+	const unsigned sub = 4;                                                     // cycles between output samples taken
+
+	for (int n = 0; n < nframes; n++) {
+		s->cycle_error += s->clock_hz;
+		unsigned cycles = s->cycle_error / s->sample_rate;
+		s->cycle_error -= cycles * s->sample_rate;
+
+		float direct = 0.0f, filt = 0.0f;
+		unsigned taken = 0;
+		float sum_direct = 0.0f, sum_filt = 0.0f;
+		for (unsigned c = 0; c < cycles; c++) {
+			cycle(s);
+			if ((c % sub) != 0) continue;
+			taken++;
+			for (int i = 0; i < 3; i++) {
+				const struct sid_voice *v = &s->v[i];
+				float o = ((int)wave(s, i) - 2048) * (float)v->env / 255.0f;   // about +-2048
+				if (s->res_filt & (1 << i)) {
+					sum_filt += o;
+				} else if (!(i == 2 && (s->mode_vol & 0x80))) {
+					sum_direct += o;
+				}
+			}
+		}
+		if (taken) {
+			direct = sum_direct / taken;
+			filt = sum_filt / taken;
+		}
+
+		// state-variable filter (trapezoidal integration, stable at any cutoff)
+		// on the voices routed to it; s->bp and s->lp hold its two integrator states
+		float v3 = filt - s->lp;
+		float v1 = a1 * s->bp + a2 * v3;
+		float v2 = s->lp + a2 * s->bp + a3 * v3;
+		s->bp = 2.0f * v1 - s->bp;
+		s->lp = 2.0f * v2 - s->lp;
+		float low = v2, band = v1, hp = filt - k * v1 - v2;
+		float fo = 0.0f;
+		if (s->mode_vol & 0x10) fo += low;
+		if (s->mode_vol & 0x20) fo += band;
+		if (s->mode_vol & 0x40) fo += hp;
+
+		float sample = (direct + fo) * (float)vol / 15.0f / 6144.0f * 1.6f;  // three voices at full scale ~ +-1
+		if (sample > 1.0f) sample = 1.0f;
+		if (sample < -1.0f) sample = -1.0f;
+		float a = fabsf(sample);
+		if (a > s->peak) s->peak = a;
+		s->frames++;
+		if (out) out[n] = sample;
+	}
+}
diff --git a/src/sid.h b/src/sid.h
new file mode 100644
index 00000000..d7595cb4
--- /dev/null
+++ b/src/sid.h
@@ -0,0 +1,73 @@
+/* MOS 6581 "SID" sound chip, as emulated by a CoCoXSID cartridge.
+ *
+ * Copyright 2026
+ *
+ * This file is part of XRoar, a Dragon/Tandy CoCo emulator.
+ *
+ * XRoar is free software; you can redistribute it and/or modify it under the
+ * terms of the GNU General Public License as published by the Free Software
+ * Foundation, either version 3 of the License, or (at your option) any later
+ * version.
+ *
+ * See COPYING.GPL for redistribution conditions.
+ */
+
+/* A compact SID: three voices (triangle, sawtooth, pulse, noise, and ANDed
+ * combinations), ADSR envelopes, ring modulation and hard sync, and the
+ * multimode state-variable filter.  Written from the 6581 data sheet's
+ * behaviour, not copied from another emulator.  Approximations:
+ *
+ * - combined waveforms are the bitwise AND of the selected ones;
+ * - the filter is a state-variable filter with a straight-line cutoff curve,
+ *   not the 6581's measured one;
+ * - the envelope has no "ADSR delay bug".
+ *
+ * Registers 0x00-0x18 are write-only (reading them returns 0, standing in for
+ * the bus), 0x19/0x1A (paddles) read 0xFF, 0x1B is OSC3 and 0x1C is ENV3.
+ */
+
+#ifndef XROAR_SID_H_
+#define XROAR_SID_H_
+
+#include <stdint.h>
+
+struct sid_voice {
+	uint32_t acc;          // 24-bit phase accumulator
+	uint16_t freq;
+	uint16_t pw;           // 12-bit pulse width
+	uint8_t ctrl, ad, sr;
+	uint32_t lfsr;         // 23-bit noise shift register
+	int msb_rise;          // accumulator bit 23 rose this cycle
+	// envelope
+	uint8_t env;
+	uint8_t state;         // 0 attack, 1 decay/sustain, 2 release
+	uint8_t gate;
+	uint16_t rate_counter, rate_period;
+	uint8_t exp_counter, exp_period;
+	uint8_t hold_zero;
+};
+
+struct sid {
+	struct sid_voice v[3];
+	uint8_t cutoff_lo, cutoff_hi, res_filt, mode_vol;
+	// timing
+	unsigned clock_hz, sample_rate;
+	unsigned cycle_error;
+	// filter state
+	float lp, bp;
+	// statistics (for logging)
+	float peak;
+	unsigned long frames;
+};
+
+void sid_init(struct sid *s, unsigned clock_hz, unsigned sample_rate);
+void sid_reset(struct sid *s);
+void sid_write(struct sid *s, unsigned reg, uint8_t value);
+uint8_t sid_read(struct sid *s, unsigned reg);
+
+// Render nframes mono samples (about -1..1) at the sample rate, advancing the
+// chip by the matching number of clock cycles.  out may be NULL to just
+// advance.
+void sid_render(struct sid *s, float *out, int nframes);
+
+#endif
