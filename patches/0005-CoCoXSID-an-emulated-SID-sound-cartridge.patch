diff --git a/tools/sid_test.c b/tools/sid_test.c
new file mode 100644
index 00000000..24cd26a4
--- /dev/null
+++ b/tools/sid_test.c
@@ -0,0 +1,219 @@
+/* Standalone test of the SID core (src/sid.c).
+ *   cc -I. -Isrc -o sid_test tools/sid_test.c src/sid.c -lm && ./sid_test
+ * Each check measures the generated audio or the chip's registers against what
+ * the 6581 data sheet says (pitch from the frequency word at a 1 MHz clock,
+ * envelope times, pulse width, filter response, hard sync, readable registers).
+ */
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "sid.h"
+
+#define CLK 1000000
+#define RATE 48000
+
+static int failures;
+static void check(int ok, const char *fmt, ...) __attribute__((format(printf, 2, 3)));
+#include <stdarg.h>
+static void check(int ok, const char *fmt, ...) {
+	va_list ap;
+	printf("  %s ", ok ? "ok  " : "FAIL");
+	va_start(ap, fmt);
+	vprintf(fmt, ap);
+	va_end(ap);
+	printf("\n");
+	if (!ok) failures++;
+}
+
+static void w(struct sid *s, unsigned r, unsigned v) { sid_write(s, r, (uint8_t)v); }
+
+/* voice 1 note: freq word, control byte, with an instant, full-sustain envelope */
+static void note(struct sid *s, unsigned voice, unsigned f, unsigned ctrl, unsigned pw) {
+	unsigned b = voice * 7;
+	w(s, b + 0, f & 255); w(s, b + 1, f >> 8);
+	w(s, b + 2, pw & 255); w(s, b + 3, pw >> 8);
+	w(s, b + 5, 0x00);       // attack 0, decay 0
+	w(s, b + 6, 0xf0);       // sustain 15, release 0
+	w(s, b + 4, ctrl | 1);   // gate on
+}
+
+static void settle(struct sid *s) { sid_render(s, NULL, RATE / 10); }   // let the envelope reach sustain
+
+static double rms(const float *b, int n) {
+	double t = 0;
+	for (int i = 0; i < n; i++) t += b[i] * b[i];
+	return sqrt(t / n);
+}
+
+static double hz_by_crossings(const float *b, int n) {
+	int c = 0;
+	for (int i = 1; i < n; i++) if (b[i - 1] < 0 && b[i] >= 0) c++;
+	return c * (double)RATE / n;
+}
+
+int main(void) {
+	static float buf[RATE * 2];
+	struct sid s;
+
+	printf("== pitch (frequency word at a 1 MHz clock)\n");
+	{
+		unsigned f440 = (unsigned)lround(440 * 16.777216);
+		const struct { const char *name; unsigned ctrl; } w3[] = { { "triangle", 0x10 }, { "sawtooth", 0x20 }, { "pulse", 0x40 } };
+		for (int i = 0; i < 3; i++) {
+			sid_init(&s, CLK, RATE);
+			w(&s, 0x18, 15);
+			note(&s, 0, f440, w3[i].ctrl, 0x800);
+			settle(&s);
+			sid_render(&s, buf, RATE);
+			double hz = hz_by_crossings(buf, RATE);
+			check(fabs(hz - 440.0) < 2.0, "%s with word %u plays %.1f Hz (440)", w3[i].name, f440, hz);
+		}
+		sid_init(&s, CLK, RATE);
+		w(&s, 0x18, 15);
+		note(&s, 0, 7382 * 2, 0x10, 0);
+		settle(&s);
+		sid_render(&s, buf, RATE);
+		check(fabs(hz_by_crossings(buf, RATE) - 880.0) < 3.0, "doubling the word doubles the pitch (%.1f Hz)", hz_by_crossings(buf, RATE));
+	}
+
+	printf("== pulse width\n");
+	{
+		sid_init(&s, CLK, RATE);
+		w(&s, 0x18, 15);
+		note(&s, 0, (unsigned)lround(220 * 16.777216), 0x40, 0x400);   // 25%
+		settle(&s);
+		sid_render(&s, buf, RATE);
+		int hi = 0;
+		for (int i = 0; i < RATE; i++) if (buf[i] > 0) hi++;
+		check(fabs(hi / (double)RATE - 0.25) < 0.02, "pulse width $400 is high %.1f%% of the time (25%%)", 100.0 * hi / RATE);
+	}
+
+	printf("== envelope times (data sheet: attack 2 ms .. 8 s)\n");
+	{
+		const struct { unsigned a; double ms; } att[] = { { 0, 2 }, { 4, 38 }, { 7, 80 }, { 9, 250 }, { 11, 800 } };
+		for (unsigned i = 0; i < sizeof att / sizeof att[0]; i++) {
+			sid_init(&s, CLK, RATE);
+			w(&s, 0x18, 15);
+			w(&s, 0x0e, 0x00); w(&s, 0x0f, 0x10);          // voice 3 running
+			w(&s, 0x13, att[i].a << 4); w(&s, 0x14, 0xf0);
+			w(&s, 0x12, 0x11);                              // triangle + gate
+			double ms = -1;
+			for (int step = 0; step < 100000 && ms < 0; step++) {
+				sid_render(&s, NULL, 1);
+				if (sid_read(&s, 0x1c) == 0xff) ms = step * 1000.0 / RATE;
+			}
+			check(ms >= 0 && fabs(ms - att[i].ms) <= att[i].ms * 0.15 + 1.0, "attack %u reaches full level in %.0f ms (%.0f)", att[i].a, ms, att[i].ms);
+		}
+		// decay to a sustain level, then hold
+		sid_init(&s, CLK, RATE);
+		w(&s, 0x18, 15);
+		w(&s, 0x13, 0x04); w(&s, 0x14, 0x80);              // attack 0, decay 4, sustain 8, release 0
+		w(&s, 0x12, 0x11);
+		sid_render(&s, NULL, RATE);
+		unsigned e1 = sid_read(&s, 0x1c);
+		sid_render(&s, NULL, RATE);
+		unsigned e2 = sid_read(&s, 0x1c);
+		check(e1 == 136 && e2 == 136, "sustain level 8 holds at %u then %u (136)", e1, e2);
+		// release back to silence
+		w(&s, 0x14, 0x84);                                  // release 4 (114 ms nominal)
+		w(&s, 0x12, 0x10);                                  // gate off
+		double ms = -1;
+		for (int step = 0; step < 100000 && ms < 0; step++) {
+			sid_render(&s, NULL, 1);
+			if (sid_read(&s, 0x1c) == 0) ms = step * 1000.0 / RATE;
+		}
+		check(ms > 60 && ms < 300, "release 4 drops from sustain to nothing in %.0f ms (data sheet: 114 ms for a full fall)", ms);
+	}
+
+	printf("== master volume and voice 3 off\n");
+	{
+		double r[3];
+		unsigned vols[3] = { 0, 7, 15 };
+		for (int i = 0; i < 3; i++) {
+			sid_init(&s, CLK, RATE);
+			w(&s, 0x18, vols[i]);
+			note(&s, 0, 7382, 0x20, 0);
+			settle(&s);
+			sid_render(&s, buf, RATE / 2);
+			r[i] = rms(buf, RATE / 2);
+		}
+		check(r[0] < 1e-6, "volume 0 is silent (rms %.5f)", r[0]);
+		check(fabs(r[2] / r[1] - 15.0 / 7.0) < 0.1, "volume 15 is %.2f times volume 7 (2.14)", r[2] / r[1]);
+		sid_init(&s, CLK, RATE);
+		w(&s, 0x18, 15 | 0x80);                               // voice 3 off
+		note(&s, 2, 7382, 0x20, 0);
+		settle(&s);
+		sid_render(&s, buf, RATE / 2);
+		check(rms(buf, RATE / 2) < 1e-6, "voice 3 off silences voice 3 (rms %.5f)", rms(buf, RATE / 2));
+	}
+
+	printf("== filter\n");
+	{
+		double un, lp, hp;
+		sid_init(&s, CLK, RATE); w(&s, 0x18, 15);
+		note(&s, 0, (unsigned)lround(2000 * 16.777216), 0x20, 0); settle(&s); sid_render(&s, buf, RATE / 2); un = rms(buf, RATE / 2);
+		sid_init(&s, CLK, RATE); w(&s, 0x18, 15 | 0x10); w(&s, 0x17, 0x01); w(&s, 0x16, 0x08);   // low-pass, cutoff low, voice 1 filtered
+		note(&s, 0, (unsigned)lround(2000 * 16.777216), 0x20, 0); settle(&s); sid_render(&s, buf, RATE / 2); lp = rms(buf, RATE / 2);
+		check(lp < un * 0.5, "low-pass at a low cutoff takes a 2 kHz saw down %.1f dB", 20 * log10(un / lp));
+		sid_init(&s, CLK, RATE); w(&s, 0x18, 15);
+		note(&s, 0, (unsigned)lround(100 * 16.777216), 0x20, 0); settle(&s); sid_render(&s, buf, RATE / 2); un = rms(buf, RATE / 2);
+		sid_init(&s, CLK, RATE); w(&s, 0x18, 15 | 0x40); w(&s, 0x17, 0x01); w(&s, 0x16, 0xf0);  // high-pass, cutoff high
+		note(&s, 0, (unsigned)lround(100 * 16.777216), 0x20, 0); settle(&s); sid_render(&s, buf, RATE / 2); hp = rms(buf, RATE / 2);
+		check(hp < un * 0.5, "high-pass at a high cutoff takes a 100 Hz saw down %.1f dB", 20 * log10(un / hp));
+		sid_init(&s, CLK, RATE); w(&s, 0x18, 15 | 0x10); w(&s, 0x17, 0x00); w(&s, 0x16, 0x08);   // filter on but no voice routed to it
+		note(&s, 0, (unsigned)lround(2000 * 16.777216), 0x20, 0); settle(&s); sid_render(&s, buf, RATE / 2);
+		check(rms(buf, RATE / 2) > un * 0.3, "a voice not routed to the filter is not filtered");
+	}
+
+	printf("== hard sync\n");
+	{
+		// voice 1 saw at about 1.5 kHz, synced to voice 3 at 440 Hz: the result repeats at 440 Hz
+		sid_init(&s, CLK, RATE); w(&s, 0x18, 15);
+		note(&s, 2, (unsigned)lround(440 * 16.777216), 0x00, 0);                 // voice 3 silent source, running
+		w(&s, 0x12, 0x01);                                                       // gate only, no waveform
+		note(&s, 0, (unsigned)lround(1510 * 16.777216), 0x22, 0);               // saw + sync
+		settle(&s);
+		sid_render(&s, buf, RATE);
+		int lag = (int)lround(RATE / 440.0), best = 0; double bestc = -1e9;
+		for (int l = 20; l < 400; l++) {
+			double c = 0; for (int i = 0; i < 4000; i++) c += buf[1000 + i] * buf[1000 + i + l];
+			if (c > bestc) { bestc = c; best = l; }
+		}
+		check(abs(best - lag) <= 2, "synced saw repeats every %d samples (440 Hz = %d)", best, lag);
+	}
+
+	printf("== test bit, noise, readable registers\n");
+	{
+		sid_init(&s, CLK, RATE); w(&s, 0x18, 15);
+		note(&s, 0, 7382, 0x28, 0);                                              // saw + test
+		settle(&s); sid_render(&s, buf, 2000);
+		double lo = 1e9, hi = -1e9; for (int i = 0; i < 2000; i++) { if (buf[i] < lo) lo = buf[i]; if (buf[i] > hi) hi = buf[i]; }
+		check(hi - lo < 1e-6, "the test bit holds the oscillator still");
+		sid_init(&s, CLK, RATE); w(&s, 0x18, 15);
+		note(&s, 0, 0xc000, 0x80, 0); settle(&s); sid_render(&s, buf, 4000);
+		double m = 0; for (int i = 0; i < 4000; i++) m += buf[i]; m /= 4000;
+		double v = 0; for (int i = 0; i < 4000; i++) v += (buf[i] - m) * (buf[i] - m);
+		check(sqrt(v / 4000) > 0.05, "noise is not a steady tone (rms %.3f)", sqrt(v / 4000));
+		// OSC3 changes, ENV3 follows the gate, write-only registers read as 0
+		sid_init(&s, CLK, RATE);
+		w(&s, 0x0e, 0xff); w(&s, 0x0f, 0xff); w(&s, 0x12, 0x21); w(&s, 0x13, 0x00); w(&s, 0x14, 0xf0);
+		unsigned seen[16]; int n = 0, distinct = 0;
+		for (int k = 0; k < 16; k++) { sid_render(&s, NULL, 7); seen[k] = sid_read(&s, 0x1b); }
+		for (int a = 0; a < 16; a++) { int d = 1; for (int b2 = 0; b2 < a; b2++) if (seen[b2] == seen[a]) d = 0; distinct += d; n++; }
+		check(distinct > 6, "OSC3 reads %d different values over 16 reads of a fast saw", distinct);
+		check(sid_read(&s, 0x1c) == 0xff, "ENV3 reads full level with the gate on and attack 0");
+		check(sid_read(&s, 0x04) == 0 && sid_read(&s, 0x18) == 0, "write-only registers read as 0");
+		check(sid_read(&s, 0x19) == 0xff, "the paddle inputs read 255");
+		w(&s, 0x12, 0x20);
+		sid_render(&s, NULL, RATE);
+		check(sid_read(&s, 0x1c) == 0, "ENV3 falls to 0 after the gate goes off");
+		sid_reset(&s);
+		sid_render(&s, buf, 1000);
+		check(rms(buf, 1000) == 0, "reset is silent");
+	}
+
+	printf("%s\n", failures ? "FAILURES" : "ALL PASSED");
+	return failures ? 1 : 0;
+}
-- 
