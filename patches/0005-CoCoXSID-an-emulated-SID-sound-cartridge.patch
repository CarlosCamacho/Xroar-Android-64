diff --git a/src/cocoxsid.c b/src/cocoxsid.c
new file mode 100644
index 00000000..06adbb49
--- /dev/null
+++ b/src/cocoxsid.c
@@ -0,0 +1,183 @@
+/* CoCoXSID cartridge: an emulated MOS 6581 SID sound chip.
+ *
+ * Copyright 2026
+ *
+ * This file is part of XRoar, a Dragon/Tandy CoCo emulator.
+ *
+ * XRoar is free software; you can redistribute it and/or modify it under the
+ * terms of the GNU General Public License as published by the Free Software
+ * Foundation, either version 3 of the License, or (at your option) any later
+ * version.
+ *
+ * See COPYING.GPL for redistribution conditions.
+ */
+
+/* SID register n is at $FF40 + n: the cartridge answers in the whole SCS
+ * window, which it shares with the disk controller, so it normally lives in a
+ * Multi-Pak slot selected by $FF7F (slot 1 by convention).  The chip runs at an
+ * assumed 1.000 MHz clock (the published player's pitch table is tuned to it;
+ * the real board's clock is not documented).
+ *
+ * The real cartridge has a switch sending its audio either to the SND pin or
+ * to an external jack.  Here the audio is mixed straight to the output, like
+ * the external jack.
+ */
+
+#include "top-config.h"
+
+#include <assert.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "array.h"
+#include "cart.h"
+#include "logging.h"
+#include "part.h"
+#include "serialise.h"
+#include "sid.h"
+#include "sound.h"
+
+#define SID_CLOCK_HZ 1000000
+
+struct cocoxsid {
+	struct cart cart;
+	struct sid sid;
+	struct sound_interface *snd;
+};
+
+static const struct ser_struct ser_struct_cocoxsid[] = {
+	SER_ID_STRUCT_NEST(1, &cart_ser_struct_data),
+};
+
+static const struct ser_struct_data cocoxsid_ser_struct_data = {
+	.elems = ser_struct_cocoxsid,
+	.num_elems = ARRAY_N_ELEMENTS(ser_struct_cocoxsid),
+};
+
+// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
+
+static uint8_t cocoxsid_read(struct cart *c, uint16_t A, bool P2, bool R2, uint8_t D);
+static uint8_t cocoxsid_write(struct cart *c, uint16_t A, bool P2, bool R2, uint8_t D);
+static void cocoxsid_reset(struct cart *c, bool hard);
+static void cocoxsid_attach(struct cart *c);
+static void cocoxsid_detach(struct cart *c);
+static bool cocoxsid_has_interface(struct cart *c, const char *ifname);
+static void cocoxsid_attach_interface(struct cart *c, const char *ifname, void *intf);
+static float cocoxsid_get_audio(void *sptr, uint32_t tick, int nframes, float *buf);
+
+// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
+
+static struct part *cocoxsid_allocate(void);
+static void cocoxsid_initialise(struct part *p, void *options);
+static bool cocoxsid_finish(struct part *p);
+
+static const struct partdb_entry_funcs cocoxsid_funcs = {
+	.allocate = cocoxsid_allocate,
+	.initialise = cocoxsid_initialise,
+	.finish = cocoxsid_finish,
+	.free = cart_rom_free,
+
+	.ser_struct_data = &cocoxsid_ser_struct_data,
+
+	.is_a = dragon_cart_is_a,
+};
+
+const struct cart_partdb_entry cocoxsid_part = { .partdb_entry = { .name = "cocoxsid", .description = "Sheldon MacDonald / Brendan Donahe | CoCoXSID (SID sound)", .funcs = &cocoxsid_funcs } };
+
+static struct part *cocoxsid_allocate(void) {
+	struct cocoxsid *x = part_new(sizeof(*x));
+	struct cart *c = &x->cart;
+	struct part *p = &c->part;
+
+	*x = (struct cocoxsid){0};
+
+	cart_rom_init(c);
+	c->read = cocoxsid_read;
+	c->write = cocoxsid_write;
+	c->reset = cocoxsid_reset;
+	c->attach = cocoxsid_attach;
+	c->detach = cocoxsid_detach;
+	c->has_interface = cocoxsid_has_interface;
+	c->attach_interface = cocoxsid_attach_interface;
+
+	sid_init(&x->sid, SID_CLOCK_HZ, 48000);
+	return p;
+}
+
+static void cocoxsid_initialise(struct part *p, void *options) {
+	cart_rom_initialise(p, options);
+}
+
+static bool cocoxsid_finish(struct part *p) {
+	return cart_rom_finish(p);
+}
+
+// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
+
+static void cocoxsid_reset(struct cart *c, bool hard) {
+	struct cocoxsid *x = (struct cocoxsid *)c;
+	cart_rom_reset(c, hard);
+	if (hard) {
+		sid_reset(&x->sid);
+	}
+}
+
+static void cocoxsid_attach(struct cart *c) {
+	cart_rom_attach(c);
+}
+
+static void cocoxsid_detach(struct cart *c) {
+	struct cocoxsid *x = (struct cocoxsid *)c;
+	LOG_MOD_DEBUG(1, "cocoxsid", "%lu audio frames, peak level %.3f\n", x->sid.frames, (double)x->sid.peak);
+	if (x->snd) {
+		x->snd->get_non_muxed_audio.func = NULL;
+	}
+	cart_rom_detach(c);
+}
+
+static bool cocoxsid_has_interface(struct cart *c, const char *ifname) {
+	return c && (0 == strcmp(ifname, "sound"));
+}
+
+static void cocoxsid_attach_interface(struct cart *c, const char *ifname, void *intf) {
+	if (!c || (0 != strcmp(ifname, "sound"))) {
+		return;
+	}
+	struct cocoxsid *x = (struct cocoxsid *)c;
+	x->snd = intf;
+	sid_init(&x->sid, SID_CLOCK_HZ, x->snd->framerate > 0 ? (unsigned)x->snd->framerate : 48000);
+	x->snd->get_non_muxed_audio = DELEGATE_AS3(float, uint32, int, floatp, cocoxsid_get_audio, x);
+}
+
+// Called for every stretch of emulated time: advance the chip and give the
+// mixer its samples.
+
+static float cocoxsid_get_audio(void *sptr, uint32_t tick, int nframes, float *buf) {
+	struct cocoxsid *x = sptr;
+	(void)tick;
+	sid_render(&x->sid, buf, nframes);
+	return 0.0f;
+}
+
+// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
+
+// SID register n is at $FF40 + n; the cart is only asked when SCS is active.
+
+static uint8_t cocoxsid_read(struct cart *c, uint16_t A, bool P2, bool R2, uint8_t D) {
+	struct cocoxsid *x = (struct cocoxsid *)c;
+	(void)R2;
+	if (P2) {
+		return sid_read(&x->sid, A & 0x1f);
+	}
+	return D;
+}
+
+static uint8_t cocoxsid_write(struct cart *c, uint16_t A, bool P2, bool R2, uint8_t D) {
+	struct cocoxsid *x = (struct cocoxsid *)c;
+	(void)R2;
+	if (P2) {
+		sid_write(&x->sid, A & 0x1f, D);
+	}
+	return D;
+}
